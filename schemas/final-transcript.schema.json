{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finovate-2026.local/schemas/final-transcript.schema.json",
  "title": "Final diarized transcript",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversation_id", "caller_speaker_id", "turns"],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "caller_speaker_id": {
      "type": "string",
      "pattern": "^SPEAKER_[0-9]{2,}$"
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/turn"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker_id", "role", "text", "start_ms", "end_ms"],
      "properties": {
        "speaker_id": {
          "type": "string",
          "pattern": "^SPEAKER_[0-9]{2,}$"
        },
        "role": {
          "enum": ["caller", "customer", "unknown"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
